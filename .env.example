# Runtime secrets are generated into the ignored .local/ directory by scripts.
# Never put actual credentials here.
ODOO_BASE_URL=http://odoo:8069
ODOO_DATABASE=purchaseflow_odoo
ODOO_API_KEY_FILE=/run/purchaseflow-secrets/odoo-api-key
APP_DATABASE_URL_FILE=/run/purchaseflow-secrets/app-database-url
